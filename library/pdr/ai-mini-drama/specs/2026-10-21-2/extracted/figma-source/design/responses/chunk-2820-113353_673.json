GHT","sg":[[0,33,7]]},"p":848},{"i":"4249:32366","t":"FRAME","n":"story","b":[8476,24,343,914],"rb":[8476,546,343,392],"dr":0.43,"f":[7],"s":[2],"sw":1,"cr":12,"l":23,"ch":["FIXED","HUG"],"bv":{"fills":[4],"strokes":[1]},"p":848},{"i":"4249:32367","t":"FRAME","n":"Story Outline","b":[8492,40,311,706],"rb":[8492,546,311,200],"dr":0.28,"l":13,"ch":["FILL","HUG"],"p":850},{"i":"4249:32368","t":"FRAME","n":"title","b":[8492,40,311,14],"dr":0,"l":6,"ch":["FILL","HUG"],"p":851},{"i":"4249:32369","t":"TEXT","n":"Story Outline","b":[8492,40,311,14],"dr":0,"ch":["FILL","HUG","grow:1"],"bv":{"fills":[5]},"tx":{"c":"Story Outline","ar":"HEIGHT","sg":[[0,13,8]]},"p":852},{"i":"4249:32370","t":"TEXT","n":"A homeless man with a brilliant business idea survives by working odd jobs and writing plans in a torn notebook. After helping a struggling diner owner solve a costly problem, he meets a retired entrepreneur who gives him one chance to prove himself. With no money, no home, and no safety net, he builds a startup from nothing, faces rejection from investors, and finally becomes a CEO who returns to help others like him. Possible Characters: Ethan — Homeless dreamer, smart and determined Margaret — Retired entrepreneur, strict but kind Sam — Diner owner, gives Ethan his first chance Maya — Young reporter, follows Ethan’s journey Victor — Investor, cold and hard to impress Jordan — Old friend, doubts Ethan’s comeback Noah — Street kid, reminds Ethan why success matters","b":[8492,62,311,684],"rb":[8492.38,546,308.37,198.46],"dr":0.29,"ch":["FILL","HUG"],"st":{"t":1},"bv":{"fills":[2]},"tx":{"c":"When the company announces a strict ban on office romance, a dedicated employee realizes her growing feelings for her direct manager could put both of their careers at risk. After a late-night elevator incident brings them unexpectedly close, they begin dating in secret, hiding their relationship behind professional distance, coded messages, and discreet meetings outside the office. As rumors spread and they are nearly caught together, her manager becomes colder in public to protect them, creating tension and doubt between them. Their worst fear comes true when HR launches an investigation following an anonymous report, forcing them to choose between their careers and their relationship. In the end, he decides to reveal the truth and request a transfer, accepting the professional consequences so they can finally be together without hiding.\n\nPossible Characters:\nSophie: A careful and detailed office worker who is deeply in love with her manager, constantly trying to balance her career with her secret passion.\nThe Manager: A disciplined, restrained leader who lets his guard down only when alone with Sophie, desperately trying to protect her and their career.\nHR Officer: A vigilant HR representative who strictly enforces the company's no-dating policy and watches employees closely.\nCoworker: An overly curious colleague who frequently wanders the halls and almost catches Sophie and the Manager in their private moments.","ar":"HEIGHT","sg":[[0,1438,1]]},"p":851},{"i":"4249:32371","t":"VECTOR","n":"Vector 1","b":[8492,762,311,0],"rb":[8492,761.5,311,1],"s":[2],"sw":1,"sa":"CENTER","ch":["FILL","FIXED"],"bv":{"strokes":[1]},"p":850},{"i":"4249:32372","t":"FRAME","n":"Characters Result","b":[8492,778,311,144],"rb":[8492,778,327,144],"l":4,"ch":["FILL","HUG"],"p":850},{"i":"4249:32373","t":"FRAME","n":"title","b":[8492,778,311,24],"l":6,"ch":["FILL","HUG"],"p":856},{"i":"4249:32374","t":"TEXT","n":"Characters Result","b":[8492,783,223,14],"rb":[8492.75,785.18,99.42,9.02],"ch":["FILL","HUG","grow:1"],"st":{"t":2},"bv":{"fills":[5]},"tx":{"c":"Characters Result","ar":"HEIGHT","sg":[[0,17,2]]},"p":857},{"i":"4249:32375","t":"FRAME","n":"button","b":[8727,778,76,24],"dr":0,"o":0,"f":[26],"s":[27],"sw":1,"cr":50,"l":24,"ch":["HUG","FIXED"],"bv":{"fills":[20],"strokes":[21]},"p":857},{"i":"4249:32376","t":"FRAME","n":"round/ic_library","b":[8734,782,16,16],"d
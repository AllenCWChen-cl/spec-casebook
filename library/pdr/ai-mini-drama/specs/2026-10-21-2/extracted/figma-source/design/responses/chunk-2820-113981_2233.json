343,914],"dr":0,"f":[22],"s":[19],"sw":1,"cr":12,"l":15,"ch":["FIXED","HUG"],"bv":{"fills":[18],"strokes":[16]},"p":2313},{"i":"2820:115045","t":"FRAME","n":"Story Outline","b":[791,-1379,311,706],"dr":0,"l":16,"ch":["FILL","HUG"],"p":2315},{"i":"2820:115046","t":"FRAME","n":"title","b":[791,-1379,311,14],"dr":0,"l":17,"ch":["FILL","HUG"],"p":2316},{"i":"2820:115047","t":"TEXT","n":"Story Outline","b":[791,-1379,311,14],"dr":0,"ch":["FILL","HUG","grow:1"],"bv":{"fills":[19]},"tx":{"c":"Story Outline","ar":"HEIGHT","sg":[[0,13,5]]},"p":2317},{"i":"2820:115048","t":"TEXT","n":"A homeless man with a brilliant business idea survives by working odd jobs and writing plans in a torn notebook. After helping a struggling diner owner solve a costly problem, he meets a retired entrepreneur who gives him one chance to prove himself. With no money, no home, and no safety net, he builds a startup from nothing, faces rejection from investors, and finally becomes a CEO who returns to help others like him. Possible Characters: Ethan — Homeless dreamer, smart and determined Margaret — Retired entrepreneur, strict but kind Sam — Diner owner, gives Ethan his first chance Maya — Young reporter, follows Ethan’s journey Victor — Investor, cold and hard to impress Jordan — Old friend, doubts Ethan’s comeback Noah — Street kid, reminds Ethan why success matters","b":[791,-1357,311,684],"dr":0,"ch":["FILL","HUG"],"st":{"t":1},"bv":{"fills":[9]},"tx":{"c":"When the company announces a strict ban on office romance, a dedicated employee realizes her growing feelings for her direct manager could put both of their careers at risk. After a late-night elevator incident brings them unexpectedly close, they begin dating in secret, hiding their relationship behind professional distance, coded messages, and discreet meetings outside the office. As rumors spread and they are nearly caught together, her manager becomes colder in public to protect them, creating tension and doubt between them. Their worst fear comes true when HR launches an investigation following an anonymous report, forcing them to choose between their careers and their relationship. In the end, he decides to reveal the truth and request a transfer, accepting the professional consequences so they can finally be together without hiding.\n\nPossible Characters:\nSophie: A careful and detailed office worker who is deeply in love with her manager, constantly trying to balance her career with her secret passion.\nThe Manager: A disciplined, restrained leader who lets his guard down only when alone with Sophie, desperately trying to protect her and their career.\nHR Officer: A vigilant HR representative who strictly enforces the company's no-dating policy and watches employees closely.\nCoworker: An overly curious colleague who frequently wanders the halls and almost catches Sophie and the Manager in their private moments.","ar":"HEIGHT","sg":[[0,1438,3]]},"p":2316},{"i":"2820:115049","t":"VECTOR","n":"Vector 1","b":[791,-657,311,0],"s":[19],"sw":1,"sa":"CENTER","ch":["FILL","FIXED"],"bv":{"strokes":[16]},"p":2315},{"i":"2820:115050","t":"FRAME","n":"Characters Result","b":[791,-641,311,144],"dr":0,"l":14,"ch":["FILL","HUG"],"p":2315},{"i":"2820:115051","t":"FRAME","n":"title","b":[791,-641,311,24],"dr":0,"l":17,"ch":["FILL","HUG"],"p":2321},{"i":"2820:115052","t":"TEXT","n":"Characters Result","b":[791,-636,223,14],"dr":0,"ch":["FILL","HUG","grow:1"],"st":{"t":2},"bv":{"fills":[19]},"tx":{"c":"Characters Result","ar":"HEIGHT","sg":[[0,17,6]]},"p":2322},{"i":"2820:115053","t":"FRAME","n":"button","b":[1026,-641,76,24],"dr":0,"o":0,"f":[24],"s":[25],"sw":1,"cr":50,"l":18,"ch":["HUG","FIXED"],"bv":{"fills":[20],"strokes":[21]},"p":2322},{"i":"2820:115054","t":"FRAME","n":"round/ic_library","b":[1033,-637,16,16],"dr":0,"c":1,"f":[26],"ch":["FIXED","FIXED"],"p":2324},{"i":"2820:115055","t":"BOOLEAN_OPERATION","n":"Union","b":[1035.17,-634.83,11.67,11.67],"dr":0,"f":[20],"bv":{"fills":[9]},"p":2325},{"i":"28
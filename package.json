    "fingerprint": "node scripts/fingerprint.ts",
    "review": "node scripts/review.ts",
    "export": "node scripts/export.ts",
    "add-spec": "node scripts/add-spec.ts",
    "new-draft": "node scripts/new-draft.ts",
    "spec-boards": "node scripts/spec-boards.ts",

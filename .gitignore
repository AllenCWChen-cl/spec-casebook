node_modules/
.DS_Store

# Images and videos stay local (user, 2026-10-22): run screenshots, eBug attachments, renders and recordings.
# The repo keeps the text that points at them (results.csv, reports, eBug drafts with file names).
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.bmp
*.tif
*.tiff
*.mp4
*.mov
*.m4v

# Python caches, the local venv and patch leftovers
__pycache__/
.venv/
*.pyc
*.orig
*.rej

# Library paths are library/<product>/<feature>/… (user, 2026-10-29).
# Original spec files (large PDFs, images) and rendered page tiles stay local; the repo keeps
# spec-set.json (names, sizes, SHA-256), the SUPERSEDED note of a replaced set, and the extracted text.
library/*/*/specs/*/*
!library/*/*/specs/*/spec-set.json
!library/*/*/specs/*/SUPERSEDED.md
!library/*/*/specs/*/extracted/
library/*/*/specs/*/extracted/*
!library/*/*/specs/*/extracted/*.txt
!library/*/*/specs/*/extracted/*.md
!library/*/*/specs/*/extracted/*.json
!library/*/*/specs/*/extracted/boards/
library/*/*/specs/*/extracted/boards/*/
# Board screenshots from Figma get_screenshot (boards newer than the PDF) are shared so no one spends Figma quota on
# them again (user, 2026-10-29): one file per board, overwritten when re-captured; figma-check.ts --prune deletes the rest
!library/*/*/specs/*/extracted/figma/
library/*/*/specs/*/extracted/figma/*
!library/*/*/specs/*/extracted/figma/*.png
!library/*/*/specs/*/extracted/figma/shots.json
# figma-source reads (scripts/figma-source.ts): the use_figma returns and board fingerprints are shared so no one reads
# an unchanged board again; the rendered calls and the expanded output (and the full-size screenshots) stay local
!library/*/*/specs/*/extracted/figma-source/
library/*/*/specs/*/extracted/figma-source/*/calls/
library/*/*/specs/*/extracted/figma-source/*/out/
library/*/*/*/drafts/*/server.log

# Run screenshot folders stay local, including the on-screen text dumps saved next to each screenshot
library/*/*/*/runs/*/screenshots/
# Design check captures (figma skill, user 2026-11-03): a compact copy of each capture (750 px WebP and its page source)
# is shared with the run, so another computer can check, review and show the Design tab without the phone's files
!library/*/*/*/runs/*/design/captures/*.webp

# Pulled app logs (may hold tokens) stay local
library/*/*/*/runs/*/logs/
library/*/*/*/runs/*/.session
library/*/*/*/runs/*/.case
library/*/*/*/runs/*/.window
library/*/*/*/runs/*/.devices.json
# Full pulled app logs attached to eBugs (may hold tokens) stay local; excerpts in ebugs/*/logs are checked first
library/*/*/*/ebugs/*/full_logs/

# Coverage pages embed spec renders and run screenshots (local only, like the images themselves)
library/*/*/*/coverage.html

# eBug review pages embed every screenshot as base64 (several MB each) and the run plan servers' logs are local noise;
# both stay local (user, 2026-10-28: keep the repo lean; the pages committed earlier were untracked 2026-10-29).
library/*/*/*/ebugs/*/*_eBug_review_*.html
library/*/*/*/runs/plan-server*.log
# eBug filing staging folders are regenerated copies of the drafts' bodies and attachments (drafts_to_bodies.py)
library/*/*/*/ebugs/*/upload/
library/*/*/*/ebugs/*/upload_filing/

# Domain knowledge (user, 2026-11-03): entries are small Markdown and are committed; a source's original files (docs,
# PDFs, exports, images) stay local like spec files, and only its source.json and extracted text are shared.
library/knowledge/sources/*/*
library/*/knowledge/sources/*/*
library/*/*/knowledge/sources/*/*
!library/knowledge/sources/*/source.json
!library/*/knowledge/sources/*/source.json
!library/*/*/knowledge/sources/*/source.json
!library/knowledge/sources/*/extracted/
!library/*/knowledge/sources/*/extracted/
!library/*/*/knowledge/sources/*/extracted/
library/knowledge/sources/*/extracted/*
library/*/knowledge/sources/*/extracted/*
library/*/*/knowledge/sources/*/extracted/*
!library/knowledge/sources/*/extracted/*.md
!library/*/knowledge/sources/*/extracted/*.md
!library/*/*/knowledge/sources/*/extracted/*.md
!library/knowledge/sources/*/extracted/*.txt
!library/*/knowledge/sources/*/extracted/*.txt
!library/*/*/knowledge/sources/*/extracted/*.txt
